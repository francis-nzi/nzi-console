{
  "name": "nzi-console",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "acceptance:provision": "npm run acceptance:provision -w @nzi/isolated-backend",
    "backfill:client-references": "npm run backfill:client-references -w @nzi/isolated-backend",
    "build": "npm run build -w @nzi/console",
    "check:conflicts": "node scripts/check-conflict-markers.mjs",
    "check:dates": "node scripts/check-date-helpers.mjs",
    "check:decisions": "node scripts/check-decisions.mjs",
    "check:migrations-frozen": "node scripts/check-migrations-frozen.mjs",
    "check:terminology": "node scripts/check-terminology.mjs",
    "console:build": "npm run build -w @nzi/console",
    "console:dev": "npm run dev -w @nzi/console",
    "dev": "npm run dev -w @nzi/console",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate -w @nzi/isolated-backend",
    "migrate:baseline": "npm run migrate:baseline -w @nzi/isolated-backend",
    "migrate:status": "npm run migrate:status -w @nzi/isolated-backend",
    "seed:portal-acceptance": "npm run seed:portal-acceptance -w @nzi/isolated-backend",
    "seed:reference-data": "npm run seed:reference-data -w @nzi/isolated-backend",
    "start": "npm run start -w @nzi/console",
    "test:console": "npm run test -w @nzi/console",
    "test:e2e": "npm run test:e2e -w @nzi/console",
    "test:e2e:gate": "npm run test:e2e:gate -w @nzi/console && node scripts/check-gate-ran.mjs",
    "test:portal": "node --import tsx --test apps/console/tests/crpReleaseControl.test.ts apps/console/tests/portalAccessibility.test.ts apps/console/tests/portalSecurityAcceptance.test.ts apps/console/tests/portalValidation.test.ts packages/isolated-backend/tests/auth.test.ts packages/isolated-backend/tests/crpLifecycle.test.ts packages/isolated-backend/tests/login.test.ts packages/isolated-backend/tests/portalAccess.test.ts packages/isolated-backend/tests/portalDataEntry.test.ts packages/isolated-backend/tests/portalDeliverables.test.ts packages/isolated-backend/tests/portalInvitations.test.ts packages/isolated-backend/tests/portalReview.test.ts",
    "test:ruling-gate": "node --test scripts/ruling-gate.test.mjs",
    "test:staff": "node --import tsx --test apps/console/tests/staffWorkspaceAcceptance.test.ts packages/isolated-backend/tests/auth.test.ts packages/isolated-backend/tests/isolation.test.ts packages/isolated-backend/tests/postgres.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
